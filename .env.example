# === Database ===
DATABASE_URL="postgresql://usdtgw:YOUR_PASSWORD@localhost:5432/usdt_gateway?schema=public"

# === Server ===
PORT=3002

# === Admin CMS Login ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# === TronGrid API (blockchain access) ===
# Get free key at: https://www.trongrid.io/
TRONGRID_API_KEY=your-trongrid-api-key

# === Encryption Key (AES-256-CBC for wallet private keys) ===
# ⚠️ MUST be exactly 32 characters
# ⚠️ DO NOT CHANGE after wallets have been added — private keys will be unreadable
ENCRYPTION_KEY=change_this_to_32_char_secret!!!
